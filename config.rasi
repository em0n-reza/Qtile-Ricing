* {
    font: "SF Mono Semibold 12";
    g-spacing: 10px;
    g-margin: 0;
    b-color: #000000FF;
    fg-color: #b0b0b0;
    fgp-color: #888888FF;
    b-radius: 2px;
    g-padding: 3px;
    hl-color: #4f2424;
    hlt-color: #000000FF;
    alt-color: #0c0c0fFF;
    wbg-color: #000000D9;
    w-border: 1.5px solid;
    w-border-color: #8f5d5d;
    w-padding: 3px;
}

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: " ";
}

listview {
    columns: 1;
    lines: 8;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0px solid;
}

window {
    transparency: "real";
    width: 1100px;
    border-radius: @b-radius;
    background-color: @wbg-color;
    border: @w-border;
    border-color: @w-border-color;
    padding: @w-padding;
}

prompt {
    text-color: @fg-color;
}

inputbar {
    children: ["prompt", "entry"];
    spacing: @g-spacing;
}

entry {
    placeholder: "Search Apps";
    text-color: @fg-color;
    placeholder-color: @fgp-color;
}

mainbox {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    children: ["inputbar", "listview", "message"];
}

element {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    border: 0px solid;
    border-radius: @b-radius;
    border-color: @b-color;
    background-color: transparent;
    text-color: @fg-color;
}

element normal.normal {
	background-color: transparent;
	text-color: @fg-color;
}

element alternate.normal {
	background-color: @alt-color;
	text-color: @fg-color;
}

element selected.active {
	background-color: @hl-color;
	text-color: #b8b8b8;
  text-decoration: none;
}

element selected.normal {
	background-color: @hl-color;
	text-color: #b8b8b8;
  text-decoration: none;
}

message {
    background-color: red;
    border: 0px solid;
}

